            "title": "Cost Estimate Usd"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "latency_ms": {
            "additionalProperties": true,
            "default": {},
            "title": "Latency Ms",
            "type": "object"
          },
          "model_kind": {
            "enum": [
              "mock",
              "real"
            ],
            "title": "Model Kind",
            "type": "string"
          },
          "notices": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Notices",
            "type": "array"
          },
          "provenance": {
            "default": [],
